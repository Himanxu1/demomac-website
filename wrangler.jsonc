{
  // screentoast.com — static files in this folder, plus worker/ for /api/seats.
  // Deploy: `wrangler deploy` from this folder.
  "name": "screentoast-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-26",
  // run_worker_first: the Worker sees /media/* so it can answer Range
  // requests (see ranged() in worker/index.js), and the DMG, deltas and
  // appcast so it can count downloads and update checks (countFetch());
  // everything else is served straight from the static assets.
  "assets": { "directory": ".", "binding": "ASSETS", "run_worker_first": ["/api/*", "/media/*", "/screen-studio-alternative", "/screen-studio-alternative.html", "/*.dmg", "/*.delta", "/appcast.xml"],
              // Unknown paths get 404.html (built from pages/404.html) with a real 404 status.
              "not_found_handling": "404-page" },
  // Shared with founder-dashboard (same account), which reads it back.
  "analytics_engine_datasets": [{ "binding": "AE", "dataset": "founder_events" }],
  "d1_databases": [
    { "binding": "DB", "database_name": "screentoast-requests",
      "database_id": "6e2fd6d8-417a-4a91-a6d5-0b13b53a571f",
      "migrations_dir": "worker/migrations" }
  ],
  // To get an email for each new request, add (address must be verified in
  // Cloudflare → Email Routing → Destination addresses):
  //   "send_email": [{ "name": "NOTIFY", "destination_address": "you@example.com" }],
  "vars": {
    // Fill in from Dodo → Discounts → EARLY39. Until then the page shows the
    // launch price without a seat count.
    "DODO_DISCOUNT_ID": "dsc_0NoiZil0lh49bLeR1hXMx",
    "SEAT_TOTAL": "92",
    // Sender for request notifications — must be on screentoast.com.
    "NOTIFY_FROM": "requests@screentoast.com"
  }
}
